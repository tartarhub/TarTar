-- // Function to add item to List
local function addProductToList(id)
    if listFrame:FindFirstChild(tostring(id)) then return end
    rapidStates[id] = false
    
    local name = "Loading..."
    local success, info = pcall(function() return MarketplaceService:GetProductInfo(id, Enum.InfoType.Product) end)
    if success and info then name = info.Name else name = "Unknown Product" end

    local entry = Instance.new("Frame")
    entry.Name = tostring(id)
    entry.Size = UDim2.new(1, -10, 0, 40)
    entry.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
    entry.Parent = listFrame
    createCorner(entry, 4)

    local prodName = Instance.new("TextLabel")
    prodName.Size = UDim2.new(0.5, 0, 1, 0)
    prodName.Position = UDim2.new(0, 10, 0, 0)
    prodName.BackgroundTransparency = 1
    prodName.Text = name .. " (" .. id .. ")"
    prodName.TextColor3 = Color3.fromRGB(200, 200, 200)
    prodName.TextSize = 11
    prodName.Font = Enum.Font.Gotham
    prodName.TextXAlignment = Enum.TextXAlignment.Left
    prodName.Parent = entry

    -- // Standard Spoof Button
    local runBtn = Instance.new("TextButton")
    runBtn.Size = UDim2.new(0, 65, 0, 26)
    runBtn.Position = UDim2.new(1, -145, 0.5, -13)
    runBtn.BackgroundColor3 = ACCENT
    runBtn.Text = "SPOOF"
    runBtn.Font = Enum.Font.GothamBold
    runBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    runBtn.TextSize = 10
    runBtn.Parent = entry
    createCorner(runBtn, 4)

    -- // Rapid Toggle Button (Added)
    local rapidBtn = Instance.new("TextButton")
    rapidBtn.Size = UDim2.new(0, 65, 0, 26)
    rapidBtn.Position = UDim2.new(1, -75, 0.5, -13)
    rapidBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    rapidBtn.Text = "AUTO"
    rapidBtn.Font = Enum.Font.GothamBold
    rapidBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    rapidBtn.TextSize = 10
    rapidBtn.Parent = entry
    createCorner(rapidBtn, 4)
    createStroke(rapidBtn, Color3.fromRGB(60, 60, 70))

    runBtn.MouseButton1Click:Connect(function()
        spoofPurchase(id)
        runBtn.Text = "FINISHED"
        task.wait(0.5)
        runBtn.Text = "SPOOF"
    end)

    rapidBtn.MouseButton1Click:Connect(function()
        rapidStates[id] = not rapidStates[id]
        
        if rapidStates[id] then
            rapidBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
            rapidBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            rapidBtn.Text = "STOP"
            
            task.spawn(function()
                while rapidStates[id] do
                    spoofPurchase(id)
                    task.wait(0.05) -- Rapid Speed
                end
            end)
        else
            rapidBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
            rapidBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
            rapidBtn.Text = "AUTO"
        end
    end)
end

