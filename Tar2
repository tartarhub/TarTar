const express = require('express');
const axios = require('axios');
const app = express();
app.use(express.json());

app.post('/generate', async (req, res) => {
    const userPrompt = req.body.prompt;

    try {
        const aiResponse = await axios.post('https://api.openai.com/v1/chat/completions', {
            model: "gpt-4o",
            messages: [{
                role: "system", 
                content: "You are a Roblox Luau expert. Return ONLY raw code, no markdown, no explanations."
            }, {
                role: "user", 
                content: `Write a Roblox script for: ${userPrompt}`
            }]
        }, {
            headers: { 'Authorization': `Bearer YOUR_API_KEY` }
        });

        const code = aiResponse.data.choices[0].message.content;
        res.json({ generated_code: code });
    } catch (err) {
        res.status(500).send("AI Error");
    }
});

app.listen(3000, () => console.log("Proxy Running"));
